<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="InstaFab icon"
                android:src="@drawable/ic_instafab" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="InstaFab" android:textColor="#11131A" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="By PaliaAPK HUB" android:textColor="#B51DD0" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Developer by shanpalia" android:textColor="#70757F" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/platformInstagram" android:layout_width="120dp" android:layout_height="48dp" android:background="@drawable/chip_selected" android:gravity="center" android:text="Instagram" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/platformFacebook" android:layout_width="120dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/chip_outline" android:gravity="center" android:text="Facebook" android:textColor="#20232B" android:textSize="15sp" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/platformTikTok" android:layout_width="120dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/chip_outline" android:gravity="center" android:text="TikTok" android:textColor="#20232B" android:textSize="15sp" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/platformTwitter" android:layout_width="120dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/chip_outline" android:gravity="center" android:text="Twitter / X" android:textColor="#20232B" android:textSize="15sp" android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/search_background" android:paddingStart="14dp" android:paddingEnd="6dp">
            <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="🔗" android:textSize="20sp" />
            <EditText android:id="@+id/searchInput" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:hint="Username or profile link" android:inputType="textUri" android:maxLines="1" android:paddingStart="5dp" android:textColor="#151820" android:textColorHint="#8A8F9B" android:textSize="16sp" />
            <TextView android:id="@+id/searchButton" android:layout_width="116dp" android:layout_height="50dp" android:background="@drawable/chip_selected" android:gravity="center" android:maxLines="1" android:text="Search Profile" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="16dp" android:orientation="horizontal" android:weightSum="4">
            <TextView android:id="@+id/actionProfile" android:layout_width="0dp" android:layout_height="96dp" android:layout_weight="1" android:gravity="center" android:text="◉\nProfile\nViewer" android:textColor="#20232B" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/card_background" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/actionVideo" android:layout_width="0dp" android:layout_height="96dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:text="↓\nVideo\nDownloader" android:textColor="#20232B" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/card_background" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/actionPhoto" android:layout_width="0dp" android:layout_height="96dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:text="▣\nPhoto\nDownloader" android:textColor="#20232B" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/card_background" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/actionHistory" android:layout_width="0dp" android:layout_height="96dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:text="◷\nDownload\nHistory" android:textColor="#20232B" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/card_background" android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Public profile viewer" android:textColor="#11131A" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Select a platform and search a username." android:textColor="#70757F" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:orientation="vertical" android:padding="24dp" android:background="@drawable/card_background">
            <ImageView android:layout_width="78dp" android:layout_height="78dp" android:contentDescription="InstaFab" android:src="@drawable/ic_instafab" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Ready to search" android:textColor="#11131A" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="No fake or demo profile data. A real permitted source is required to display profile details." android:textColor="#70757F" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="20dp" android:gravity="center" android:orientation="horizontal" android:background="@drawable/card_background">
            <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂\nHome" android:textColor="#6B1DCE" android:textSize="12sp" android:textStyle="bold" android:clickable="true" />
            <TextView android:id="@+id/navDownloads" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="↓\nDownloads" android:textColor="#555A66" android:textSize="12sp" android:clickable="true" />
            <TextView android:id="@+id/navSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌕\nSearch" android:textColor="#555A66" android:textSize="12sp" android:clickable="true" />
            <TextView android:id="@+id/navHistory" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="◷\nHistory" android:textColor="#555A66" android:textSize="12sp" android:clickable="true" />
            <TextView android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⚙\nSettings" android:textColor="#555A66" android:textSize="12sp" android:clickable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
